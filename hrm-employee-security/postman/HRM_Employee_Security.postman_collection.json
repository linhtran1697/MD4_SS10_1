{
  "info": {
    "name": "HRM Employee Security - Default Authentication",
    "description": "GET /api/v1/employees với Spring Security mặc định. Chạy ứng dụng, sao chép mật khẩu từ Console vào biến securityPassword trước khi gửi request 03.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "securityPassword",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Chưa xác thực",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/employees",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "employees"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 401', () => pm.response.to.have.status(401));",
              "pm.test('Không lộ dữ liệu nhân viên', () => {",
              "  pm.expect(pm.response.text()).not.to.include('fullName');",
              "  pm.expect(pm.response.text()).not.to.include('salary');",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "02 - Sai mật khẩu",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "user",
              "type": "string"
            },
            {
              "key": "password",
              "value": "wrong-password-for-demo",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/employees",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "employees"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 401', () => pm.response.to.have.status(401));",
              "pm.test('Không lộ dữ liệu nhân viên', () => {",
              "  pm.expect(pm.response.text()).not.to.include('fullName');",
              "  pm.expect(pm.response.text()).not.to.include('salary');",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "03 - Đúng tài khoản mặc định",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "user",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{securityPassword}}",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/employees",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "employees"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Trả về đúng 3 nhân viên và dữ liệu', () => {",
              "  pm.expect(pm.response.json()).to.deep.equal([",
              "    {id: 1, fullName: \"Nguyễn Văn An\", salary: 18000000},",
              "    {id: 2, fullName: \"Trần Thị Bình\", salary: 22000000},",
              "    {id: 3, fullName: \"Lê Văn Cường\", salary: 25000000}",
              "  ]);",
              "});"
            ]
          }
        }
      ],
      "response": []
    }
  ]
}
